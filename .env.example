# ── SAP integration ───────────────────────────────────────────────────────────
SAP_SERVER_SECRET=your-sap-server-secret-here

# ── Kuehne+Nagel Freight Booking API ─────────────────────────────────────────
# Full URL of the KN booking endpoint (e.g. https://api.kuehne-nagel.com/...)
KN_API_URL=https://api.kuehne-nagel.com/bookings/v1

# Mandatory KN administrative credentials (provided by KN)
KN_CUSTOMER_ID=CustomerBranchWest
KN_CUSTOMER_KEY=your-kn-customer-key-here

# Base64 client secret used to obtain an OAuth access token (client_credentials
# grant against https://portal.api.kuehne-nagel.com/oauth2/token). Shared by
# both the booking API above and the Document Management API below.
KN_SECRET_64=your-kn-base64-client-secret-here

# ── Kuehne+Nagel Shipment Document Management API ────────────────────────────
# Separate service from the booking API above, but authenticates with the
# same OAuth client-credentials token (KN_SECRET_64 above). Defaults to the
# URL in KN's published swagger, so this only needs setting if KN ever
# versions the path.
KN_DOCUMENTS_API_URL=https://gateway.api.kuehne-nagel.com/transport/execution/documentation/shipment/v2

# ── ClearPort Customs Declaration API ────────────────────────────────────────
# Base URL — defaults to https://api.clear-port.com if not set
CLEARPORT_API_URL=https://api.clear-port.com

# Bearer token issued by ClearPort (used in Authorization header)
CLEARPORT_API_TOKEN=your-clearport-bearer-token-here

# ── Knex migration tooling (knexfile.cjs) ────────────────────────────────────
# Deliberately separate from the app's own DB connection (config.json's
# sqlConfig, read at runtime) — this points the migration CLI at whichever
# SQL Server you're building/migrating right now (the new test server while
# it's being stood up, later the real target on cutover), so there's no risk
# of `npx knex migrate:latest` accidentally hitting production.
MIGRATE_DB_SERVER=localhost
MIGRATE_DB_USER=your-migration-user
MIGRATE_DB_PASSWORD=your-migration-password
MIGRATE_DB_PORT=1433

# Only set this if the server above is a NAMED instance (e.g. SQL Server
# Express's default "SQLEXPRESS" instance rather than a default/unnamed
# instance). When set, MIGRATE_DB_PORT is ignored — the SQL Server Browser
# service (UDP 1434) resolves the real port instead, so leave that service
# running on the target machine.
#MIGRATE_DB_INSTANCE=SQLEXPRESS

# ── Logistics document folders (shared drive UNC paths) ──────────────────────
# Inbound supplier invoices / shipping documents — one folder per shipment,
# auto-created at {Year}\{MM}. {MonthName}\{ShipmentReference} - {SupplierName}\
LOGISTICS_IMPORT_ROOT=\\server\share\Logistics\IMPORTS\Imports\

# Auto-generated Purchase Order PDFs — {VendorName}\{PoNumber}.pdf, written
# the moment a PO is created via "Create PO in SAP" (see lib/poPdf.js).
LOGISTICS_PO_ROOT=\\server\share\Logistics\Re-Ordering\Purchase Orders\
