<?xml version="1.0" encoding="utf-8"?>
<!--
  Committed here (rather than letting Microsoft.NET.Sdk.Web generate one from
  scratch on every publish) purely to flip stdoutLogEnabled to true — the SDK's
  own generated default is false. dotnet publish still fills in
  processPath/arguments/hostingModel via its normal token-replacement pass
  when a web.config already exists in the project, so this stays otherwise
  identical to the generated file (confirmed via a real `dotnet publish`
  during Phase 10 — this is not a fully hand-maintained file).

  stdoutLogEnabled=true captures ANCM's own early-startup diagnostic text
  (anything before this app's own managed logging pipeline is even up — the
  ASP.NET Core Module's equivalent of the "instant crash, zero log output"
  failure class SapServer hit for real under IIS, see that repo's
  CLAUDE.md) into publish\logs\stdout_<timestamp>_<pid>.log. install.ps1
  creates and grants the app pool identity Modify access to publish\logs\
  for exactly this reason, mirroring SapServer's own logs\ permissions
  precedent (the same folder Data Protection's persisted key ring also
  lives in — see Program.cs's AddDataProtection call).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\NormantonNexus.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
