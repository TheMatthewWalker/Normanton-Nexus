@page
@model NormantonNexus.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Normanton Nexus — Reset password</title>
    <link rel="icon" href="~/images/logo16.png" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="login-shell">
        <div class="login-page">
            <div class="login-brand">
                <div class="login-brand-logo">
                    <img src="~/images/logo256.png" alt="Kongsberg" />
                    <span class="login-brand-name">Normanton Nexus</span>
                </div>
                <div class="login-brand-sub">Enterprise Operations Portal</div>
            </div>

            <div class="login-card">
                <div class="login-eyebrow">Choose a new password</div>

                @if (Model.Submitted)
                {
                    <p style="color:var(--success); font-weight:600; margin: 0 0 16px;">Password updated successfully.</p>
                    <div class="switch-link"><a asp-page="./Login">Sign in</a></div>
                }
                else
                {
                    @if (Model.ErrorMessage is not null)
                    {
                        <p class="login-error" role="alert">@Model.ErrorMessage</p>
                    }

                    <form method="post" asp-page="./ResetPassword">
                        <input type="hidden" asp-for="Token" />
                        <div>
                            <label for="NewPassword">New password</label>
                            <input type="password" id="NewPassword" asp-for="NewPassword" placeholder="Min 10 chars, 1 uppercase, 1 number" autocomplete="new-password" required />
                        </div>
                        <div>
                            <label for="ConfirmPassword">Confirm password</label>
                            <input type="password" id="ConfirmPassword" asp-for="ConfirmPassword" placeholder="Re-enter new password" autocomplete="new-password" required />
                        </div>

                        <button type="submit">Update password</button>
                    </form>

                    <div class="switch-link" style="margin-top:12px;"><a asp-page="./Login">Back to sign in</a></div>
                }
            </div>

            <div class="login-footer-note">Normanton Nexus &middot; Authorised access only &middot; All activity is logged</div>
        </div>
    </div>
</body>
</html>
