@page
@model NormantonNexus.Pages.LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Normanton Nexus — Log in</title>
    <link rel="icon" href="~/images/logo16.png" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="login-shell">
        <div class="login-page">
            <div class="login-brand">
                <div class="login-brand-logo">
                    <img src="~/images/logo256.png" alt="Kongsberg" />
                    <span class="login-brand-name">Normanton Nexus</span>
                </div>
                <div class="login-brand-sub">Enterprise Operations Portal</div>
            </div>

            <div class="login-card">
                <div class="login-eyebrow">Authentication</div>

                @if (Model.ErrorCode is not null)
                {
                    <p class="login-error" role="alert">
                        @(Model.ErrorCode switch
                        {
                            "pending_approval" => "Your account is pending approval.",
                            "account_locked" => "Your account is locked. Contact an administrator.",
                            "too_many_attempts" => "Too many login attempts. Please try again later.",
                            _ => "Invalid username or password.",
                        })
                    </p>
                }

                <form method="post" asp-page="./Login">
                    <div>
                        <label for="Username">Username</label>
                        <input type="text" id="Username" name="Username" placeholder="Enter username" autocomplete="username" required />
                    </div>
                    <div>
                        <label for="Password">Password</label>
                        <input type="password" id="Password" name="Password" placeholder="••••••••" autocomplete="current-password" required />
                    </div>

                    <button type="submit">Authenticate</button>
                </form>

                <div class="switch-link" style="margin-top:12px;"><a asp-page="./ForgotPassword">Forgot password?</a></div>
            </div>

            <div class="login-footer-note">Normanton Nexus &middot; Authorised access only &middot; All activity is logged</div>
        </div>
    </div>
</body>
</html>
