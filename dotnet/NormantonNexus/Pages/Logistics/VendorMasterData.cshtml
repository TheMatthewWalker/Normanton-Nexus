@page
@model NormantonNexus.Pages.Logistics.VendorMasterDataModel
@{
    ViewData["Title"] = "Vendor Master Data";
    ViewData["Department"] = "Logistics";
    ViewData["PageTitle"] = "Vendor Master Data";
    ViewData["PageSubtitle"] = "MRP vendor and vendor-material configuration";
}

<p><a asp-page="Index">&larr; Logistics</a></p>

<form id="vm-form">
    <div class="nx-toolbar" style="margin-bottom:10px">
        <div class="tf-row" style="flex:1;flex-wrap:wrap;margin-bottom:0">
            <div class="tf-field">
                <label class="tf-label" for="vm-name">Vendor Name</label>
                <input type="text" id="vm-name" class="tf-input" required>
            </div>
            <div class="tf-field">
                <label class="tf-label" for="vm-sap-number">SAP Vendor Number</label>
                <input type="text" id="vm-sap-number" class="tf-input">
            </div>
            <div class="tf-field" style="max-width:90px">
                <label class="tf-label" for="vm-currency">Currency</label>
                <input type="text" id="vm-currency" class="tf-input" maxlength="3">
            </div>
            <div class="tf-field" style="max-width:90px">
                <label class="tf-label" for="vm-incoterms">Incoterms</label>
                <input type="text" id="vm-incoterms" class="tf-input" maxlength="3">
            </div>
            <div class="tf-field" style="max-width:170px">
                <label class="tf-label" for="vm-lead-time">Default Lead Time (days)</label>
                <input type="number" id="vm-lead-time" class="tf-input">
            </div>
            <div class="tf-field" style="justify-content:flex-end;flex-direction:row;gap:8px">
                <button type="submit" class="btn">Add Vendor</button>
            </div>
        </div>
    </div>
</form>
<div id="vm-body"></div>

@section Scripts {
    <script src="~/js/logistics/vendor-master-data.js"></script>
}
