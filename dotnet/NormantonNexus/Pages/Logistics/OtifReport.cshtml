@page
@model NormantonNexus.Pages.Logistics.OtifReportModel
@{
    ViewData["Title"] = "Haulier On-Time Performance";
    ViewData["Department"] = "Logistics";
    ViewData["PageTitle"] = "Haulier On-Time Performance";
    ViewData["PageSubtitle"] = "OTIF by haulier, country, destination and month";
}

<p><a asp-page="Index">&larr; Logistics</a></p>
<label>Months<input type="number" id="or-months" value="12" min="1" max="60" style="width:80px;"></label>
<button type="button" class="btn secondary" id="or-refresh">Refresh</button>
<div id="or-body" style="margin-top:0.75rem;"></div>

@section Scripts {
    <script src="~/js/logistics/otif-report.js"></script>
}
