@page
@model NormantonNexus.Pages.Logistics.ShipmentQueueModel
@{
    ViewData["Title"] = "Shipment Queue";
    ViewData["Department"] = "Logistics";
    ViewData["PageTitle"] = "Shipment Queue";
    ViewData["PageSubtitle"] = "Awaiting Booking / Awaiting Collection / In Transit";
}

<p><a asp-page="Index">&larr; Logistics</a></p>
<label>Queue
    <select id="sq-mode">
        <option value="awaiting-booking">Awaiting Booking</option>
        <option value="awaiting-collection">Awaiting Collection</option>
        <option value="in-transit">In Transit</option>
    </select>
</label>
<div id="sq-body" style="margin-top:0.75rem;"></div>

@section Scripts {
    <script src="~/js/logistics/shipment-queue.js"></script>
}
