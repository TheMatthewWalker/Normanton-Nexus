@page
@model NormantonNexus.Pages.Logistics.CostsModel
@{
    ViewData["Title"] = "Freight Costs";
    ViewData["Department"] = "Logistics";
    ViewData["PageTitle"] = "Freight Costs";
    ViewData["PageSubtitle"] = "Unprocessed and processed freight cost lines";
}

<p><a asp-page="Index">&larr; Logistics</a></p>
<label>View
    <select id="co-mode">
        <option value="unprocessed">Unprocessed</option>
        <option value="processed">Processed</option>
    </select>
</label>
<div id="co-body" style="margin-top:0.75rem;"></div>

@section Scripts {
    <script src="~/js/logistics/costs.js"></script>
}
