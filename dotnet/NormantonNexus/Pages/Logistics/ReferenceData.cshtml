@page
@model NormantonNexus.Pages.Logistics.ReferenceDataModel
@{
    ViewData["Title"] = "Reference Data";
    ViewData["Department"] = "Logistics";
    ViewData["PageTitle"] = "Reference Data";
    ViewData["PageSubtitle"] = "Destinations, forwarders, cost centres/GL accounts, pallet &amp; packaging data, material request units";
}

<p><a asp-page="Index">&larr; Logistics</a></p>

<div class="lg-actions" style="margin-bottom:1rem; display:flex; gap:0.4rem; flex-wrap:wrap;">
    <button type="button" class="btn secondary" data-section="destinations">Destinations</button>
    <button type="button" class="btn secondary" data-section="forwarders">Forwarders</button>
    <button type="button" class="btn secondary" data-section="fmm">Forwarder Mode Mapping</button>
    <button type="button" class="btn secondary" data-section="costcenters">Cost Centres</button>
    <button type="button" class="btn secondary" data-section="costelements">GL Accounts (Cost Elements)</button>
    <button type="button" class="btn secondary" data-section="mru">Material Request Units</button>
    <button type="button" class="btn secondary" data-section="palletpack">Pallet &amp; Packaging Data</button>
</div>

<section id="rd-destinations" hidden>
    <h3>Destinations</h3>
    <input class="tf-input" id="rd-dest-search" type="text" placeholder="Search name or city…" style="max-width:280px;">
    <div id="rd-dest-list" style="margin-top:0.5rem;"></div>
    <form id="rd-dest-form" class="card" style="margin-top:0.75rem;">
        <h4 id="rd-dest-form-title">Add Destination</h4>
        <input type="hidden" id="rd-dest-id-hidden">
        <label>Destination ID<input type="number" id="rd-dest-id" required></label>
        <label>Name<input type="text" id="rd-dest-name"></label>
        <label>Street<input type="text" id="rd-dest-street"></label>
        <label>City<input type="text" id="rd-dest-city"></label>
        <label>Post Code<input type="text" id="rd-dest-postcode"></label>
        <label>Country<input type="text" id="rd-dest-country"></label>
        <label>Default Incoterms<input type="text" id="rd-dest-incoterms"></label>
        <label>Zone<input type="text" id="rd-dest-zone"></label>
        <label>Default Delivery Service<input type="text" id="rd-dest-service"></label>
        <label>Default Forwarder<input type="text" id="rd-dest-forwarder"></label>
        <label>Comment<input type="text" id="rd-dest-comment"></label>
        <button type="submit" class="btn secondary">Save</button>
        <button type="button" class="btn" id="rd-dest-cancel">Cancel Edit</button>
    </form>
</section>

<section id="rd-forwarders" hidden>
    <h3>Forwarders</h3>
    <div id="rd-fwd-list"></div>
    <form id="rd-fwd-form" class="card" style="margin-top:0.75rem;">
        <h4 id="rd-fwd-form-title">Add Forwarder</h4>
        <input type="hidden" id="rd-fwd-original-mode">
        <label>Forwarder ID<input type="number" id="rd-fwd-id" required></label>
        <label>Name<input type="text" id="rd-fwd-name" required></label>
        <label>Mode<input type="text" id="rd-fwd-mode"></label>
        <label>Approved <input type="checkbox" id="rd-fwd-approved"></label>
        <button type="submit" class="btn secondary">Save</button>
        <button type="button" class="btn" id="rd-fwd-cancel">Cancel Edit</button>
    </form>
</section>

<section id="rd-fmm" hidden>
    <h3>Forwarder Mode Mapping</h3>
    <div id="rd-fmm-list"></div>
    <form id="rd-fmm-form" class="card" style="margin-top:0.75rem;">
        <h4 id="rd-fmm-form-title">Add Mapping</h4>
        <input type="hidden" id="rd-fmm-id-hidden">
        <label>Forwarder Type<select id="rd-fmm-type" required></select></label>
        <label>Mode of Transport<input type="text" id="rd-fmm-mot" required></label>
        <label>Description<input type="text" id="rd-fmm-desc"></label>
        <button type="submit" class="btn secondary">Save</button>
        <button type="button" class="btn" id="rd-fmm-cancel">Cancel Edit</button>
    </form>
</section>

<section id="rd-costcenters" hidden>
    <h3>Cost Centres</h3>
    <div id="rd-cc-list"></div>
    <form id="rd-cc-form" class="card" style="margin-top:0.75rem;">
        <h4 id="rd-cc-form-title">Add Cost Centre</h4>
        <input type="hidden" id="rd-cc-id-hidden">
        <label>Code<input type="text" id="rd-cc-code" required></label>
        <label>Description<input type="text" id="rd-cc-desc" required></label>
        <button type="submit" class="btn secondary">Save</button>
        <button type="button" class="btn" id="rd-cc-cancel">Cancel Edit</button>
    </form>
</section>

<section id="rd-costelements" hidden>
    <h3>GL Accounts (Cost Elements)</h3>
    <div id="rd-ce-list"></div>
    <form id="rd-ce-form" class="card" style="margin-top:0.75rem;">
        <h4 id="rd-ce-form-title">Add GL Account</h4>
        <input type="hidden" id="rd-ce-id-hidden">
        <label>Code<input type="text" id="rd-ce-code" required></label>
        <label>Description<input type="text" id="rd-ce-desc" required></label>
        <label>Direction<input type="text" id="rd-ce-direction"></label>
        <label>Tier<input type="text" id="rd-ce-tier"></label>
        <button type="submit" class="btn secondary">Save</button>
        <button type="button" class="btn" id="rd-ce-cancel">Cancel Edit</button>
    </form>
</section>

<section id="rd-mru" hidden>
    <h3>Material Request Units</h3>
    <div id="rd-mru-list"></div>
    <form id="rd-mru-form" class="card" style="margin-top:0.75rem;">
        <h4 id="rd-mru-form-title">Add Request Unit</h4>
        <input type="hidden" id="rd-mru-id-hidden">
        <label>Material<input type="text" id="rd-mru-material" required></label>
        <label>Unit<input type="text" id="rd-mru-unit" required></label>
        <label>Conversion Qty<input type="number" step="0.0001" id="rd-mru-qty" required></label>
        <button type="submit" class="btn secondary">Save</button>
        <button type="button" class="btn" id="rd-mru-cancel">Cancel Edit</button>
    </form>
</section>

<section id="rd-palletpack" hidden>
    <h3>Pallet Data</h3>
    <div id="rd-pallet-list"></div>
    <h3 style="margin-top:1.25rem;">Packaging Data</h3>
    <div id="rd-pack-list"></div>
</section>

@section Scripts {
    <script src="~/js/logistics/reference-data.js"></script>
}
