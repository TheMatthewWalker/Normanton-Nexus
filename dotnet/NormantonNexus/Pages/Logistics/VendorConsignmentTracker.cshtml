@page
@model NormantonNexus.Pages.Logistics.VendorConsignmentTrackerModel
@{
    ViewData["Title"] = "Vendor Consignment Tracker";
    ViewData["Department"] = "Logistics";
    ViewData["PageTitle"] = "Vendor Consignment Tracker";
    ViewData["PageSubtitle"] = "Consignment balances, deliveries and declarations";
}

<p><a asp-page="Index">&larr; Logistics</a></p>

<div class="nx-toolbar" style="margin-bottom:10px">
    <span class="nx-toolbar-title">Vendors</span>
    <span class="nx-toolbar-spacer"></span>
    <button type="button" class="btn secondary" id="vc-refresh-stock">Refresh Stock Snapshot</button>
</div>
<div id="vc-vendors"></div>
<div id="vc-detail" style="margin-top:1rem;"></div>

@section Scripts {
    <script src="~/js/logistics/vendor-consignment-tracker.js"></script>
}
