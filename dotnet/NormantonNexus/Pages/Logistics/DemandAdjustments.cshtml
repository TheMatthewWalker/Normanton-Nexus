@page
@model NormantonNexus.Pages.Logistics.DemandAdjustmentsModel
@{
    ViewData["Title"] = "Demand Adjustments";
    ViewData["Department"] = "Logistics";
    ViewData["PageTitle"] = "Demand Adjustments";
    ViewData["PageSubtitle"] = "Manual overrides to forecast demand";
}

<p><a asp-page="Index">&larr; Logistics</a></p>

<button type="button" id="da-add-btn">+ Add Adjustment</button>

<div id="da-body" style="margin-top:0.75rem;"></div>

@section Scripts {
    <script>
        window.__daInitialMaterial = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Material));
    </script>
    <script src="~/js/logistics/demand-adjustments.js"></script>
}
