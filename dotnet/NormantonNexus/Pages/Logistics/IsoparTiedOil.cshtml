@page
@model NormantonNexus.Pages.Logistics.IsoparTiedOilModel
@{
    ViewData["Title"] = "Isopar Tied Oil";
    ViewData["Department"] = "Logistics";
    ViewData["PageTitle"] = "Isopar Tied Oil";
    ViewData["PageSubtitle"] = "Meter readings, stock risk, planning rate, HMRC declarations";
}

<p><a asp-page="Index">&larr; Logistics</a></p>

<section>
    <h3>Meter Readings</h3>
    <form id="iso-reading-form">
        <div class="nx-toolbar" style="margin-bottom:10px">
            <div class="tf-row" style="flex:1;flex-wrap:wrap;margin-bottom:0">
                <div class="tf-field" style="max-width:160px">
                    <label class="tf-label" for="iso-date">Date</label>
                    <input type="date" id="iso-date" class="tf-input" required>
                </div>
                <div class="tf-field" style="max-width:140px">
                    <label class="tf-label" for="iso-qty">Reading (L)</label>
                    <input type="number" step="0.01" id="iso-qty" class="tf-input" required>
                </div>
                <div class="tf-field">
                    <label class="tf-label" for="iso-notes">Notes</label>
                    <input type="text" id="iso-notes" class="tf-input">
                </div>
                <div class="tf-field" style="justify-content:flex-end;flex-direction:row;gap:8px">
                    <button type="submit" class="btn">Add Reading</button>
                </div>
            </div>
        </div>
    </form>
    <div id="iso-readings"></div>
</section>

<section style="margin-top:1.5rem;">
    <h3>Stock Risk</h3>
    <div id="iso-risk">Loading…</div>
</section>

<section style="margin-top:1.5rem;">
    <h3>Planning Rate</h3>
    <div id="iso-rate">Loading…</div>
    <form id="iso-rate-form" style="margin-top:0.75rem;">
        <div class="nx-toolbar" style="margin-bottom:0">
            <div class="tf-row" style="flex:1;flex-wrap:wrap;margin-bottom:0">
                <div class="tf-field" style="max-width:150px">
                    <label class="tf-label" for="iso-rate-weekday">Weekday (L/day)</label>
                    <input type="number" step="0.01" id="iso-rate-weekday" class="tf-input" required>
                </div>
                <div class="tf-field" style="max-width:150px">
                    <label class="tf-label" for="iso-rate-weekend">Weekend (L/day)</label>
                    <input type="number" step="0.01" id="iso-rate-weekend" class="tf-input" required>
                </div>
                <div class="tf-field" style="max-width:170px">
                    <label class="tf-label" for="iso-rate-capacity">Max Stock Capacity</label>
                    <input type="number" step="0.01" id="iso-rate-capacity" class="tf-input">
                </div>
                <div class="tf-field">
                    <label class="tf-label" for="iso-rate-source">Source</label>
                    <input type="text" id="iso-rate-source" class="tf-input">
                </div>
                <div class="tf-field">
                    <label class="tf-label" for="iso-rate-notes">Notes</label>
                    <input type="text" id="iso-rate-notes" class="tf-input">
                </div>
                <div class="tf-field" style="justify-content:flex-end;flex-direction:row;gap:8px">
                    <button type="submit" class="btn">Save Rate</button>
                    <button type="button" id="iso-rate-apply-recommended" class="secondary">Apply Recommended</button>
                </div>
            </div>
        </div>
    </form>
</section>

<section id="iso-decl-section" style="margin-top:1.5rem; display:none;">
    <h3>HMRC Declarations</h3>
    <div id="iso-decl-outstanding"></div>
    <h4 style="margin-top:1rem;">Submitted Declarations</h4>
    <div id="iso-decl-history"></div>
</section>

@section Scripts {
    <script src="~/js/logistics/isopar-tied-oil.js"></script>
}
