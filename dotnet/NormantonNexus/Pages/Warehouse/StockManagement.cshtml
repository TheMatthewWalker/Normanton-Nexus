@page
@model NormantonNexus.Pages.Warehouse.StockManagementModel
@{
    ViewData["Title"] = "Stock Management";
    ViewData["Department"] = "Warehouse";
    ViewData["PageTitle"] = "Stock Management";
    ViewData["PageSubtitle"] = "Search stock and create a Transfer Order";
}

<p><a asp-page="Index">&larr; Warehouse</a></p>

<form id="sm-search-form">
    <label>Material<input type="text" id="sm-material"></label>
    <label>Storage Type<input type="text" id="sm-storage-type"></label>
    <label>Bin<input type="text" id="sm-bin"></label>
    <label>Batch<input type="text" id="sm-batch"></label>
    <label>Storage Location<input type="text" id="sm-storage-location"></label>
    <button type="submit" class="btn">Search</button>
</form>

<div id="sm-results" style="margin-top:1rem;"></div>

@section Scripts {
    <script src="~/js/warehouse/stock-management.js"></script>
}
