@page
@model NormantonNexus.Pages.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["Department"] = "Account";
    ViewData["PageTitle"] = "Change Password";
    ViewData["PageSubtitle"] = "Your account requires a password change before you can continue";
}

@if (Model.ErrorMessage is not null)
{
    <p class="login-error">@Model.ErrorMessage</p>
}

<form method="post">
    <label for="CurrentPassword">Current password</label>
    <input type="password" id="CurrentPassword" asp-for="CurrentPassword" autocomplete="current-password" required />

    <label for="NewPassword">New password</label>
    <input type="password" id="NewPassword" asp-for="NewPassword" autocomplete="new-password" required minlength="8" />

    <label for="ConfirmPassword">Confirm new password</label>
    <input type="password" id="ConfirmPassword" asp-for="ConfirmPassword" autocomplete="new-password" required minlength="8" />

    <button type="submit">Change Password</button>
</form>
