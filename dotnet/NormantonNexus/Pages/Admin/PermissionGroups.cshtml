@page
@model NormantonNexus.Pages.Admin.PermissionGroupsModel
@{
    ViewData["Title"] = "Permission Groups";
    ViewData["Department"] = "Admin";
    ViewData["PageTitle"] = "Permission Groups";
    ViewData["PageSubtitle"] = "Bundle tile permissions into a named, reusable group and assign the whole group to users at once";
}

<p><a asp-page="Index">&larr; Admin</a></p>

<div class="nx-toolbar" style="margin-bottom:14px">
    <div class="pg-search" style="flex:1;max-width:360px">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input type="text" id="pg-search-input" placeholder="Search groups…">
    </div>
    <div class="nx-toolbar-spacer"></div>
    <button type="button" class="btn" id="pg-create-btn">+ New Group</button>
</div>

<div id="pg-body">Loading…</div>

@section Scripts {
    <script src="~/js/admin/permission-groups.js"></script>
}
