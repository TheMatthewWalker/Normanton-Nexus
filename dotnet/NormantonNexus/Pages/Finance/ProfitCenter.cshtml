@page
@model NormantonNexus.Pages.Finance.ProfitCenterModel
@{
    ViewData["Title"] = "Profit Center Data";
    ViewData["Department"] = "Finance";
    ViewData["PageTitle"] = "Profit Center Data";
    ViewData["PageSubtitle"] = "GL postings by profit center, invoice & material — filtered by period";
}

<p><a asp-page="Index">&larr; Finance</a></p>

<form id="pc-filters" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:0.75rem; align-items:end; max-width:700px;">
    <div>
        <label for="pc-from-m">From Period (MM)</label>
        <select id="pc-from-m"></select>
    </div>
    <div>
        <label for="pc-from-y">From Year</label>
        <input type="number" id="pc-from-y" min="2020" max="2035" />
    </div>
    <div>
        <label for="pc-to-m">To Period (MM)</label>
        <select id="pc-to-m"></select>
    </div>
    <div>
        <label for="pc-to-y">To Year</label>
        <input type="number" id="pc-to-y" min="2020" max="2035" />
    </div>
</form>

<div style="margin:0.75rem 0;">
    <div style="display:flex; gap:0.5rem;">
        <button type="button" id="pc-mode-group">Predefined Group</button>
        <button type="button" id="pc-mode-manual" class="secondary">Manual Entry</button>
    </div>

    <div id="pc-group-section" style="margin-top:0.5rem;">
        <label for="pc-group">Group</label>
        <select id="pc-group" style="max-width:280px;"></select>
        <p id="pc-group-preview" style="color:#6b7280; font-size:0.85rem;"></p>
    </div>

    <div id="pc-manual-section" style="display:none; margin-top:0.5rem;">
        <label for="pc-manual-accounts">GL Accounts (one per line, no leading zeros — e.g. 301000)</label>
        <textarea id="pc-manual-accounts" rows="4" style="width:100%; max-width:280px; box-sizing:border-box; font-family:monospace;"></textarea>
    </div>
</div>

<button type="button" id="pc-run">Run Query</button>
<p id="pc-msg" style="color:#b91c1c;"></p>

<div id="pc-summary"></div>
<div id="pc-detail"></div>

@section Scripts {
    <script src="~/js/finance/profit-center.js"></script>
}
