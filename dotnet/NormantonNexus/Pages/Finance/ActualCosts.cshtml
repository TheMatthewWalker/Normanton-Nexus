@page
@model NormantonNexus.Pages.Finance.ActualCostsModel
@{
    ViewData["Title"] = "Actual Costs";
    ViewData["Department"] = "Finance";
    ViewData["PageTitle"] = "Actual Costs";
    ViewData["PageSubtitle"] = "GL account period balances from SAP — debits, credits & running balance";
}

<p><a asp-page="Index">&larr; Finance</a></p>

<form id="ac-filters" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:0.75rem; align-items:end; max-width:700px;">
    <div>
        <label for="ac-year">Fiscal Year</label>
        <input type="number" id="ac-year" min="2020" max="2035" />
    </div>
    <div>
        <label for="ac-period-from">Period From</label>
        <select id="ac-period-from"></select>
    </div>
    <div>
        <label for="ac-period-to">Period To</label>
        <select id="ac-period-to"></select>
    </div>
</form>

<div style="margin:0.75rem 0;">
    <div style="display:flex; gap:0.5rem;">
        <button type="button" id="ac-mode-group">Predefined Group</button>
        <button type="button" id="ac-mode-manual" class="secondary">Manual Entry</button>
    </div>

    <div id="ac-group-section" style="margin-top:0.5rem;">
        <label for="ac-group">Group</label>
        <select id="ac-group" style="max-width:280px;"></select>
        <p id="ac-group-preview" style="color:#6b7280; font-size:0.85rem;"></p>
    </div>

    <div id="ac-manual-section" style="display:none; margin-top:0.5rem;">
        <label for="ac-manual-accounts">GL Accounts (one per line, no leading zeros — e.g. 601200)</label>
        <textarea id="ac-manual-accounts" rows="4" style="width:100%; max-width:280px; box-sizing:border-box; font-family:monospace;"></textarea>
    </div>
</div>

<button type="button" id="ac-run">Run Query</button>
<p id="ac-msg" style="color:#b91c1c;"></p>

<div id="ac-result"></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/finance/actual-costs.js"></script>
}
