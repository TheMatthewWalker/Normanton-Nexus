@page "{code}"
@model NormantonNexus.Pages.Production.MetreEntryModel
@{
    ViewData["Title"] = Model.ProcessLabel;
    ViewData["Department"] = "Production";
    ViewData["PageTitle"] = Model.ProcessLabel;
    ViewData["PageSubtitle"] = "Enter a completed run and post directly to SAP";
}

<p><a asp-page="Index">&larr; Production</a></p>

<div style="max-width:640px;" data-process-code="@Model.Code">
    <div class="tf-row">
        <div class="tf-field">
            <label class="tf-label" for="mp-material">Material</label>
            <input type="text" id="mp-material" class="tf-input" placeholder="Material number" />
        </div>
        <div class="tf-field">
            <label class="tf-label" for="mp-length">Length (Metres)</label>
            <input type="number" id="mp-length" class="tf-input" step="0.001" min="0.001" />
        </div>
        <div class="tf-field tf-field--wide">
            <label class="tf-label" for="mp-notes">Notes (optional)</label>
            <input type="text" id="mp-notes" class="tf-input" placeholder="Any comments…" />
        </div>
    </div>

    <div id="mp-result" style="margin:0.75rem 0;"></div>
    <div id="mp-print-widget"></div>

    <button type="button" id="mp-submit-btn" class="btn">Post to SAP</button>
</div>

<p style="margin-top:1rem;"><a asp-page="CompleteRun" asp-route-code="@Model.Code">Complete a Draft Run (with traceability &amp; scrap) &rarr;</a></p>

@section Scripts {
    <script src="~/js/production/label-print.js"></script>
    <script src="~/js/production/metre-entry.js"></script>
}
