@page
@model NormantonNexus.Pages.Production.IndexModel
@{
    ViewData["Title"] = "Production";
    ViewData["Department"] = "Production";
    ViewData["PageTitle"] = "Production";
    ViewData["PageSubtitle"] = "Select a function to begin";
}

<!--
    Section order/grouping mirrors the original Node app's
    private/production-nexus.html exactly (Production Entry / Production
    Data / Staging Post / Supervisor / Reports) rather than this page's own
    earlier ad-hoc grouping — restored for navigation parity. A later gap
    audit against the Node tile inventory found Mixing Data, Drumming Data,
    Failed Backflush and Expired Mix Batches were all genuinely missing (not
    deliberately deferred) and they're now all built and listed below —
    Mixing Data and Expired Mix Batches both needed real backend work too
    (MixingHelper.GetDataAsync/mixing/data; BilletStagingHelper.
    GetExpiredAsync/ScrapExpiredTubAsync/OverrideExpiryAsync — gated with the
    literal legacy PROD_SUPERVISOR code rather than a new per-tile one, since
    minting one needs the dotnet ef migration tooling this session doesn't
    have — see ProductionNexusController's own comment on the three new
    mixing/expired* routes), Drumming Data's and Failed Backflush's backends
    already existed. Billet Staging and Order Lookup are dotnet-only additions with no
    top-level Node tile of their own (Node reaches both through the
    Extrusion/Drumming wizards' own pickers) — kept in Production Entry since
    that's where they belong conceptually, not removed just to match Node
    literally when they're real, working tiles. The EX/CO/BR/CL/TW tiles link
    straight to CompleteRun (its 3-step Open Drafts/New Draft/Complete Run
    wizard), not MetreEntry — deliberate, per explicit direction: CompleteRun
    already covers both creating and completing a run with the more polished
    UI, so the plainer single-step MetreEntry form is skipped as the landing
    screen (its own page/route/backend `POST process/:pc/entry` are untouched
    and still directly reachable, just not linked from here).
-->

<h3>Production Entry</h3>
<div class="tile-grid">
    <a class="tile" asp-page="MixingEntry">
        <p class="tile-title">Mixing</p>
        <p class="tile-hint">Enter a completed mixing batch and post directly to SAP</p>
    </a>
    <a class="tile" asp-page="BilletStaging">
        <p class="tile-title">Billet Staging</p>
        <p class="tile-hint">Stage conditioned mix tubs into Billet, or return staged material to Conditioning</p>
    </a>
    <a class="tile" asp-page="CompleteRun" asp-route-code="EX">
        <p class="tile-title">Extrusion</p>
        <p class="tile-hint">Complete an open draft, or start a new extrusion run</p>
    </a>
    <a class="tile" asp-page="CompleteRun" asp-route-code="CO">
        <p class="tile-title">Convoluting</p>
        <p class="tile-hint">Complete an open draft, or start a new convoluting run</p>
    </a>
    <a class="tile" asp-page="CompleteRun" asp-route-code="BR">
        <p class="tile-title">Braiding</p>
        <p class="tile-hint">Complete an open draft, or start a new braiding run</p>
    </a>
    <a class="tile" asp-page="CompleteRun" asp-route-code="CL">
        <p class="tile-title">Coverline</p>
        <p class="tile-hint">Complete an open draft, or start a new coverline run</p>
    </a>
    <a class="tile" asp-page="CompleteRun" asp-route-code="TW">
        <p class="tile-title">Tape Wrap</p>
        <p class="tile-hint">Complete an open draft, or start a new tape wrap run</p>
    </a>
    <a class="tile" asp-page="DrummingEntry">
        <p class="tile-title">Drumming</p>
        <p class="tile-hint">Make-to-Stock/Make-to-Order drumming entry with traceability, coil lengths and scrap</p>
    </a>
    <a class="tile" asp-page="OrderLookup">
        <p class="tile-title">Order Lookup</p>
        <p class="tile-hint">Find an open order, check stock &amp; required, print a Drumming Ticket</p>
    </a>
</div>

<h3>Production Data</h3>
<div class="tile-grid">
    <a class="tile" asp-page="MetreProcessData" asp-route-code="EX">
        <p class="tile-title">Extrusion Data</p>
        <p class="tile-hint">Search completed/cancelled Extrusion records</p>
    </a>
    <a class="tile" asp-page="MetreProcessData" asp-route-code="CO">
        <p class="tile-title">Convoluting Data</p>
        <p class="tile-hint">Search completed/cancelled Convoluting records</p>
    </a>
    <a class="tile" asp-page="MetreProcessData" asp-route-code="BR">
        <p class="tile-title">Braiding Data</p>
        <p class="tile-hint">Search completed/cancelled Braiding records</p>
    </a>
    <a class="tile" asp-page="MetreProcessData" asp-route-code="CL">
        <p class="tile-title">Coverline Data</p>
        <p class="tile-hint">Search completed/cancelled Coverline records</p>
    </a>
    <a class="tile" asp-page="MetreProcessData" asp-route-code="TW">
        <p class="tile-title">Tape Wrap Data</p>
        <p class="tile-hint">Search completed/cancelled Tape Wrap records</p>
    </a>
    <a class="tile" asp-page="MixingData">
        <p class="tile-title">Mixing Data</p>
        <p class="tile-hint">Search completed/cancelled Mixing records</p>
    </a>
    <a class="tile" asp-page="DrummingData">
        <p class="tile-title">Drumming Data</p>
        <p class="tile-hint">Search completed/cancelled Drumming records</p>
    </a>
</div>

<h3>Staging Post</h3>
<div class="tile-grid">
    <a class="tile" asp-page="StagingPost">
        <p class="tile-title">Staging Post</p>
        <p class="tile-hint">Request material from Stores — track status by due date</p>
    </a>
</div>

<h3>Supervisor</h3>
<div class="tile-grid">
    <a class="tile" asp-page="ApproveScrap">
        <p class="tile-title">Approve Scrap</p>
        <p class="tile-hint">Supervisor approval queue — review and post operator scrap entries to SAP</p>
    </a>
    <a class="tile" asp-page="PostedScrap">
        <p class="tile-title">Posted Scrap</p>
        <p class="tile-hint">Approved and SAP-posted scrap summary by work centre and reason</p>
    </a>
    <a class="tile" asp-page="SapReversals">
        <p class="tile-title">SAP Reversals</p>
        <p class="tile-hint">Search SAP postings and reverse selected backflush documents</p>
    </a>
    <a class="tile" asp-page="ScrapReversal">
        <p class="tile-title">Scrap Reversal</p>
        <p class="tile-hint">Search and reverse SAP scrap documents · alerts on missed reversals</p>
    </a>
    <a class="tile" asp-page="Traceability">
        <p class="tile-title">Traceability</p>
        <p class="tile-hint">Trace a batch through the full production chain</p>
    </a>
    <a class="tile" asp-page="BatchHistory">
        <p class="tile-title">Batch History</p>
        <p class="tile-hint">Search completed/cancelled batches</p>
    </a>
    <a class="tile" asp-page="OpenRuns">
        <p class="tile-title">Open Runs</p>
        <p class="tile-hint">View and cancel open runs across all processes</p>
    </a>
    <a class="tile" asp-page="ProductionSchedule">
        <p class="tile-title">Production Schedule</p>
        <p class="tile-hint">Open PTFE order lines due in the next 5 working days — comments, ETA and OTIF KPI</p>
    </a>
    <a class="tile" asp-page="FailedBackflush">
        <p class="tile-title">Failed Backflush</p>
        <p class="tile-hint">Records saved locally but rejected by SAP — retry or cancel</p>
    </a>
    <a class="tile" asp-page="ExpiredMixBatches">
        <p class="tile-title">Expired Mix Batches</p>
        <p class="tile-hint">Unstaged mix tubs over 96 hours old — approve scrap, or override and stage anyway</p>
    </a>
</div>

<h3>Reports</h3>
<div class="tile-grid">
    <a class="tile" asp-page="Reports/Output">
        <p class="tile-title">Production Output</p>
        <p class="tile-hint">Metres/KG produced by process over time</p>
    </a>
    <a class="tile" asp-page="Reports/Scrap">
        <p class="tile-title">Scrap Analysis</p>
        <p class="tile-hint">Scrap KG by reason, process and trend</p>
    </a>
    <a class="tile" asp-page="Reports/SapPerformance">
        <p class="tile-title">SAP Performance</p>
        <p class="tile-hint">Backflush success rate, failures, and alerts</p>
    </a>
    <a class="tile" asp-page="Reports/Batches">
        <p class="tile-title">Batch Summary</p>
        <p class="tile-hint">Batch counts by status</p>
    </a>
    <a class="tile" asp-page="Reports/ShiftComparison">
        <p class="tile-title">Shift Performance</p>
        <p class="tile-hint">Days/Afters/Nights comparison</p>
    </a>
    <a class="tile" asp-page="Reports/OperatorOutput">
        <p class="tile-title">Operator Output</p>
        <p class="tile-hint">Output ranked by primary operator</p>
    </a>
    <a class="tile" asp-page="Reports/MaterialOutput">
        <p class="tile-title">Material Throughput</p>
        <p class="tile-hint">Output ranked by material</p>
    </a>
</div>
