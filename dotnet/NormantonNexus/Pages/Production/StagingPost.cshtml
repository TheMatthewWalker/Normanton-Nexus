@page
@model NormantonNexus.Pages.Production.StagingPostModel
@{
    ViewData["Title"] = "Staging Post";
    ViewData["Department"] = "Production";
    ViewData["PageTitle"] = "Staging Post";
    ViewData["PageSubtitle"] = "Request material from Stores — track status by due date";
}

<p><a asp-page="Index">&larr; Production</a></p>

<div class="nx-toolbar" style="margin-bottom:10px">
    <div class="nx-toolbar-spacer"></div>
    <button type="button" class="btn secondary" id="sp-refresh">Refresh</button>
</div>

<div id="sp-body"></div>

<div id="sp-deliver-panel" style="display:none;margin-top:1rem;padding:1rem;background:#fff;border:1px solid #e2e4e9;border-radius:10px;max-width:520px;">
    <h3 style="margin-top:0;">Deliver Request</h3>
    <form id="sp-deliver-form">
        <label>Quantity<input type="text" id="dv-quantity" required></label>
        <label>Batch<input type="text" id="dv-batch"></label>
        <label>Storage Location<input type="text" id="dv-storage-location"></label>
        <label>Source Type<input type="text" id="dv-source-type"></label>
        <label>Source Bin<input type="text" id="dv-source-bin"></label>
        <label>Destination Type<input type="text" id="dv-dest-type"></label>
        <label>Destination Bin<input type="text" id="dv-dest-bin"></label>
        <button type="submit" class="btn">Deliver</button>
        <button type="button" class="btn secondary" id="dv-cancel">Cancel</button>
    </form>
    <p id="dv-status"></p>
</div>

@section Scripts {
    <script src="~/js/warehouse/staging-post.js"></script>
}
