@page
@model NormantonNexus.Pages.Production.BatchHistoryModel
@{
    ViewData["Title"] = "Batch History";
    ViewData["Department"] = "Production";
    ViewData["PageTitle"] = "Batch History";
    ViewData["PageSubtitle"] = "Search completed/cancelled batches";
}

<p><a asp-page="Index">&larr; Production</a></p>

<div style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-bottom:0.75rem;">
    <input type="text" id="hist-ref" placeholder="Batch ref…" style="max-width:160px;" />
    <input type="text" id="hist-mat" placeholder="Material…" style="max-width:180px;" />
    <input type="date" id="hist-from" />
    <input type="date" id="hist-to" />
    <button type="button" id="hist-search-btn">Search</button>
</div>

<div id="hist-results">Enter search criteria and click Search.</div>

@section Scripts {
    <script src="~/js/production/reports-common.js"></script>
    <script src="~/js/production/batch-history.js"></script>
}
