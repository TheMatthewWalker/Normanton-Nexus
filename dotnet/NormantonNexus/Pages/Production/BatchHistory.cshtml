@page
@model NormantonNexus.Pages.Production.BatchHistoryModel
@{
    ViewData["Title"] = "Batch History";
    ViewData["Department"] = "Production";
    ViewData["PageTitle"] = "Batch History";
    ViewData["PageSubtitle"] = "Search completed/cancelled batches";
}

<p><a asp-page="Index">&larr; Production</a></p>

<div class="nx-toolbar" style="margin-bottom:10px">
    <div class="tf-row" style="flex:1;flex-wrap:wrap;margin-bottom:0">
        <div class="tf-field">
            <label class="tf-label" for="hist-ref">Batch Ref</label>
            <input type="text" id="hist-ref" class="tf-input" placeholder="Batch ref…" />
        </div>
        <div class="tf-field">
            <label class="tf-label" for="hist-mat">Material</label>
            <input type="text" id="hist-mat" class="tf-input" placeholder="Material…" />
        </div>
        <div class="tf-field">
            <label class="tf-label" for="hist-from">From</label>
            <input type="date" id="hist-from" class="tf-input" />
        </div>
        <div class="tf-field">
            <label class="tf-label" for="hist-to">To</label>
            <input type="date" id="hist-to" class="tf-input" />
        </div>
        <div class="tf-field" style="justify-content:flex-end;flex-direction:row;gap:8px">
            <button type="button" id="hist-search-btn" class="btn">Search</button>
        </div>
    </div>
</div>

<div id="hist-results"><div class="nx-empty">Enter search criteria and click Search.</div></div>

@section Scripts {
    <script src="~/js/production/reports-common.js"></script>
    <script src="~/js/production/batch-history.js"></script>
}
