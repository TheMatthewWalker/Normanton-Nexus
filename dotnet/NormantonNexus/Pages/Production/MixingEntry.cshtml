@page
@model NormantonNexus.Pages.Production.MixingEntryModel
@{
    ViewData["Title"] = "Mixing";
    ViewData["Department"] = "Production";
    ViewData["PageTitle"] = "Mixing";
    ViewData["PageSubtitle"] = "Enter mixing details and each supplier tub — a separate SAP posting is made per tub";
}

<p><a asp-page="Index">&larr; Production</a></p>

<div style="max-width:640px;">
    <p class="nx-toolbar-hint" style="margin:0 0 12px;">Shift is determined automatically from the current time.</p>

    <div class="tf-row">
        <div class="tf-field">
            <label class="tf-label" for="mx-mixcode">Mix Code / Material</label>
            <input type="text" id="mx-mixcode" class="tf-input" placeholder="e.g. 10101" />
        </div>
        <div class="tf-field">
            <label class="tf-label" for="mx-suppbatch">Supplier Batch No</label>
            <input type="text" id="mx-suppbatch" class="tf-input" placeholder="Supplier batch ref" />
        </div>
        <div class="tf-field">
            <label class="tf-label" for="mx-supptub">Supplier Tub No</label>
            <input type="text" id="mx-supptub" class="tf-input" placeholder="Tub reference" />
        </div>
    </div>

    <div style="display:flex; justify-content:space-between; align-items:center; margin:0.75rem 0 0.25rem;">
        <strong>Tubs</strong>
        <span id="mx-total" class="badge badge--accent">0.000 KG</span>
    </div>
    <div id="mx-tub-list"></div>
    <p class="nx-toolbar-hint" style="margin:4px 0 10px;">Maximum 38 KG per tub.</p>
    <button type="button" id="mx-add-tub" class="secondary">+ Add Tub</button>

    <div class="tf-row" style="margin-top:14px;">
        <div class="tf-field tf-field--wide">
            <label class="tf-label" for="mx-notes">Notes (optional)</label>
            <input type="text" id="mx-notes" class="tf-input" placeholder="Any comments…" />
        </div>
    </div>

    <div id="mx-result" style="margin:0.75rem 0;"></div>
    <div id="mx-print-widget"></div>

    <button type="button" id="mx-submit-btn" class="btn">Post to SAP</button>
</div>

@section Scripts {
    <script src="~/js/production/label-print.js"></script>
    <script src="~/js/production/mixing-entry.js"></script>
}
