@page
@model NormantonNexus.Pages.Production.MixingEntryModel
@{
    ViewData["Title"] = "Mixing";
    ViewData["Department"] = "Production";
    ViewData["PageTitle"] = "Mixing";
    ViewData["PageSubtitle"] = "Enter mixing details and each supplier tub — a separate SAP posting is made per tub";
}

<p><a asp-page="Index">&larr; Production</a></p>

<div style="max-width:600px;">
    <p style="color:#6b7280; font-size:0.85rem;">Shift is determined automatically from the current time.</p>

    <label for="mx-mixcode">Mix Code / Material</label>
    <input type="text" id="mx-mixcode" placeholder="e.g. 10101" />

    <label for="mx-suppbatch">Supplier Batch No</label>
    <input type="text" id="mx-suppbatch" placeholder="Supplier batch ref" />

    <label for="mx-supptub">Supplier Tub No</label>
    <input type="text" id="mx-supptub" placeholder="Tub reference" />

    <div style="display:flex; justify-content:space-between; align-items:center; margin:0.75rem 0 0.25rem;">
        <strong>Tubs</strong>
        <span id="mx-total">0.000 KG</span>
    </div>
    <div id="mx-tub-list"></div>
    <p style="color:#6b7280; font-size:0.8rem;">Maximum 38 KG per tub.</p>
    <button type="button" id="mx-add-tub" class="secondary">+ Add Tub</button>

    <label for="mx-notes">Notes (optional)</label>
    <input type="text" id="mx-notes" placeholder="Any comments…" />

    <p id="mx-result" style="margin:0.5rem 0;"></p>

    <button type="button" id="mx-submit-btn">Post to SAP</button>
</div>

@section Scripts {
    <script src="~/js/production/mixing-entry.js"></script>
}
