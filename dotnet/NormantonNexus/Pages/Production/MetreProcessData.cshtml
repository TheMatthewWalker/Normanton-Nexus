@page "{code}"
@model NormantonNexus.Pages.Production.MetreProcessDataModel
@{
    ViewData["Title"] = Model.ProcessLabel + " Data";
    ViewData["Department"] = "Production";
    ViewData["PageTitle"] = Model.ProcessLabel + " Data";
    ViewData["PageSubtitle"] = "Search completed/cancelled " + Model.ProcessLabel + " records";
}

<p><a asp-page="Index">&larr; Production</a></p>

<div data-process-code="@Model.Code">
    <div class="nx-toolbar" style="margin-bottom:10px">
        <div class="tf-row" style="flex:1;flex-wrap:wrap;margin-bottom:0">
            <div class="tf-field">
                <label class="tf-label" for="mpd-material">Material</label>
                <input type="text" id="mpd-material" class="tf-input" placeholder="e.g. K-NBR%" />
            </div>
            <div class="tf-field">
                <label class="tf-label" for="mpd-from">From</label>
                <input type="date" id="mpd-from" class="tf-input" />
            </div>
            <div class="tf-field">
                <label class="tf-label" for="mpd-to">To</label>
                <input type="date" id="mpd-to" class="tf-input" />
            </div>
            <div class="tf-field" style="justify-content:flex-end;flex-direction:row;">
                <button type="button" id="mpd-search" class="btn">Search</button>
            </div>
        </div>
    </div>
    <div id="mpd-results"><div class="nx-empty">Enter filters above and click Search.</div></div>
</div>

@section Scripts {
    <script src="~/js/production/reports-common.js"></script>
    <script src="~/js/production/metre-data.js"></script>
}
