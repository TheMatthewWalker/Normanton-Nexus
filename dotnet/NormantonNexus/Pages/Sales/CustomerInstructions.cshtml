@page
@model NormantonNexus.Pages.Sales.CustomerInstructionsModel
@{
    ViewData["Title"] = "Customer Standard Instructions";
    ViewData["Department"] = "Sales";
    ViewData["PageTitle"] = "Customer Standard Instructions";
    ViewData["PageSubtitle"] = "Standing instructions printed on every Drumming Ticket for a customer";
}

<p><a asp-page="Index">&larr; Sales</a></p>

<div style="display:flex; gap:0.5rem; margin-bottom:0.75rem;">
    <button type="button" id="ci-add-btn">+ Add Customer</button>
    <button type="button" id="ci-import-btn" class="secondary">Bulk Import</button>
</div>

<div id="ci-form" style="display:none; border:1px solid #e5e7eb; border-radius:8px; padding:1rem; margin-bottom:1rem;">
    <h3 id="ci-form-title">Add Customer</h3>
    <label for="ci-cust">Customer Number</label>
    <input type="text" id="ci-cust" />

    <label for="ci-name">Customer Name</label>
    <input type="text" id="ci-name" />

    <label for="ci-instr">Instructions</label>
    <textarea id="ci-instr" rows="4" style="width:100%; box-sizing:border-box;"></textarea>

    <p id="ci-form-msg" style="color:#b91c1c;"></p>

    <div style="display:flex; gap:0.5rem;">
        <button type="button" id="ci-save-btn">Save</button>
        <button type="button" id="ci-cancel-btn" class="secondary">Cancel</button>
    </div>
</div>

<div id="ci-import-panel" style="display:none; border:1px solid #e5e7eb; border-radius:8px; padding:1rem; margin-bottom:1rem;">
    <p style="color:#6b7280; font-size:0.85rem;">
        Paste directly from Excel — three columns: Account Code, Company Name, Special Instructions.
        A header row is fine, it's detected automatically. Matching rows (by Account Code) update the
        existing instructions; new Account Codes are added.
    </p>
    <textarea id="ci-import-paste" rows="8" placeholder="Paste rows here…" style="width:100%; box-sizing:border-box; font-family:monospace;"></textarea>
    <div style="display:flex; gap:0.5rem; margin:0.5rem 0;">
        <button type="button" id="ci-import-preview-btn" class="secondary">Preview</button>
        <button type="button" id="ci-import-go-btn" disabled>Import</button>
        <button type="button" id="ci-import-cancel-btn" class="secondary">Cancel</button>
    </div>
    <div id="ci-import-preview"></div>
    <p id="ci-import-msg"></p>
</div>

<div id="ci-table"></div>
<p id="ci-msg" style="color:#b91c1c;"></p>

@section Scripts {
    <script src="~/js/sales/customer-instructions.js"></script>
}
