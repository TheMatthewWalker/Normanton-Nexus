<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Normanton Nexus</title>

    <!-- Must be the first script, non-deferred, non-module — see wwwroot/js/shared/session-guard.js's own
         comments (ported from private/js/session-guard.js, same load-order requirement in the Node app). -->
    <script src="~/js/shared/session-guard.js"></script>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="header">
        <div class="header-left">
            <a href="~/" class="back-link">&larr; Hub</a>
            <div class="brand-sep"></div>
            <span class="brand-name">@ViewData["Department"]</span>
        </div>
        <div class="header-right">
            <div class="user-badge">
                <div class="user-dot"></div>
                <span>@User.Identity?.Name</span>
            </div>
            <a href="/Logout" class="btn-logout">Sign Out</a>
        </div>
    </header>

    <div class="page-title-bar">
        <div class="page-title-inner">
            <h1 class="page-title">@ViewData["PageTitle"]</h1>
            @if (ViewData["PageSubtitle"] is string subtitle)
            {
                <p class="page-subtitle">@subtitle</p>
            }
        </div>
    </div>

    <main class="page-content">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
