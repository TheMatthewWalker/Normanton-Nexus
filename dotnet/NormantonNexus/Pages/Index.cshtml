@page
@using NormantonNexus.Services.UI
@model NormantonNexus.Pages.IndexModel
@{
    ViewData["Title"] = "Hub";
    ViewData["Department"] = "Normanton Nexus";
    Layout = "_Layout";
}

<style>
    /* Hub grid + department cards — the hero banner above this now lives in
       _Layout.cshtml itself (it replaces the shared page-title-bar for the
       Hub specifically, so it can span the full page width the same way
       page-title-bar does — see that file). Its CSS lives in site.css for
       the same reason; only this page's own grid/card styling stays here. */
    .hub-grid-header { margin-bottom: 16px; }
    .hub-grid-eyebrow {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px; letter-spacing: 2.5px; text-transform: uppercase;
        color: var(--text-muted); margin-bottom: 4px;
    }
    .hub-grid-title { font-size: 18px; font-weight: 800; margin: 0; }

    .dept-card {
        display: flex; flex-direction: column; gap: 12px;
        padding: 18px 18px 16px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        text-decoration: none;
        color: var(--text);
        position: relative;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }
    .dept-card::before {
        content: '';
        position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
        background: var(--dept-accent, var(--accent));
        transform: scaleY(0); transform-origin: bottom;
        transition: transform 0.2s ease;
        border-radius: 0 2px 2px 0;
    }
    .dept-card:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(30,45,69,0.13); border-color: var(--border2); text-decoration: none; }
    .dept-card:hover::before { transform: scaleY(1); }
    .dept-card--admin { border-color: rgba(37,99,235,0.25); background: linear-gradient(135deg, var(--surface) 75%, rgba(219,234,254,0.5)); }

    .dept-card-top { display: flex; align-items: flex-start; gap: 12px; }
    .dept-icon {
        width: 40px; height: 40px; flex-shrink: 0;
        background: var(--dept-accent-dim, var(--surface2));
        border: 1px solid var(--border);
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        color: var(--dept-accent, var(--accent));
    }
    .dept-icon svg { width: 20px; height: 20px; }
    .dept-info { flex: 1; min-width: 0; }
    .dept-name { font-size: 15px; font-weight: 800; margin: 0 0 2px; }
    .dept-desc { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--text-muted); line-height: 1.4; margin: 0; }
    .dept-card-foot { display: flex; align-items: center; justify-content: space-between; }
    .dept-arrow {
        width: 24px; height: 24px; border-radius: 6px;
        background: var(--surface2);
        display: flex; align-items: center; justify-content: center;
        font-size: 14px; color: var(--text-muted);
        transition: all 0.18s;
    }
    .dept-card:hover .dept-arrow { background: var(--dept-accent, var(--accent)); color: #fff; transform: translateX(2px); }

    .hub-empty { font-size: 14px; color: var(--text-dim); }
</style>

<div class="hub-grid-header">
    <div class="hub-grid-eyebrow">Departments</div>
    <h2 class="hub-grid-title">Jump to your area</h2>
</div>

<div class="tile-grid" style="grid-template-columns: repeat(auto-fill, minmax(250px, 1fr))">
    @foreach (var department in Model.AccessibleDepartments)
    {
        var theme = DepartmentTheme.For(department.DisplayName);
        <a class="dept-card" href="@department.Route" style="@(theme is not null ? $"--dept-accent:{theme.Accent};--dept-accent-dim:{theme.AccentDim};" : "")">
            <div class="dept-card-top">
                <div class="dept-icon">
                    @if (theme is not null)
                    {
                        @Html.Raw($"<svg viewBox=\"0 0 24 24\" fill=\"none\">{theme.IconSvg}</svg>")
                    }
                </div>
                <div class="dept-info">
                    <p class="dept-name">@department.DisplayName</p>
                    <p class="dept-desc">@department.Description</p>
                </div>
            </div>
            <div class="dept-card-foot">
                <span class="badge badge--success">Live</span>
                <div class="dept-arrow">&rarr;</div>
            </div>
        </a>
    }
    @if (Model.ShowAdminTile)
    {
        var adminTheme = DepartmentTheme.For("Admin");
        <a class="dept-card dept-card--admin" href="/Admin/Index" style="@(adminTheme is not null ? $"--dept-accent:{adminTheme.Accent};--dept-accent-dim:{adminTheme.AccentDim};" : "")">
            <div class="dept-card-top">
                <div class="dept-icon">
                    @if (adminTheme is not null)
                    {
                        @Html.Raw($"<svg viewBox=\"0 0 24 24\" fill=\"none\">{adminTheme.IconSvg}</svg>")
                    }
                </div>
                <div class="dept-info">
                    <p class="dept-name">Admin</p>
                    <p class="dept-desc">Users, permissions, audit log, DB Explorer, BAPI Inspector</p>
                </div>
            </div>
            <div class="dept-card-foot">
                <span class="badge badge--accent">Superadmin</span>
                <div class="dept-arrow">&rarr;</div>
            </div>
        </a>
    }
</div>

@if (Model.AccessibleDepartments.Count == 0 && !Model.ShowAdminTile)
{
    <p class="hub-empty">You don't have access to any departments yet. Contact an administrator.</p>
}
