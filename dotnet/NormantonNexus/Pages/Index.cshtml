@page
@model NormantonNexus.Pages.IndexModel
@{
    ViewData["Title"] = "Hub";
    ViewData["Department"] = "Normanton Nexus";
    ViewData["PageTitle"] = "Hub";
    ViewData["PageSubtitle"] = "Select a department to begin";
}

<div class="tile-grid">
    @foreach (var department in Model.AccessibleDepartments)
    {
        <a class="tile" href="@department.Route">
            <p class="tile-title">@department.DisplayName</p>
        </a>
    }
    @if (Model.ShowAdminTile)
    {
        <a class="tile" href="/Admin/Index">
            <p class="tile-title">Admin</p>
            <p class="tile-hint">User management, permissions, audit log, DB Explorer, BAPI Inspector</p>
        </a>
    }
</div>

@if (Model.AccessibleDepartments.Count == 0)
{
    <p>You don't have access to any departments yet. Contact an administrator.</p>
}
